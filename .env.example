# Copie para .env e preencha. O .env NUNCA vai pro git.

# String longa e aleatória (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=

# Firebase Console -> Configurações do projeto -> Geral -> Chave de API da Web
FIREBASE_WEB_API_KEY=

# Crie em console.groq.com/keys. Sem ela, o chat responde 503 e o resto da API funciona.
GROQ_API_KEY=

# Opcionais (têm padrão no código)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# CORS_ORIGINS_EXTRA=https://seu-frontend.onrender.com
# CONFIA_EM_PROXY_REVERSO=true
# SENTRY_DSN=
